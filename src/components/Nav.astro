---
import { getTranslations } from "@/i18n/translations";

const { lang = "en" } = Astro.props;

const isEnglish = lang === "en";
const basePath = isEnglish ? "/" : "/es";
const t = getTranslations(lang);

const navigation = [
  { title: t.nav.tours, path: "#tours" },
  { title: t.nav.whyUs, path: "#why-us" },
  { title: t.nav.customerExperiences, path: "#customer-experiences" },
  { title: t.nav.gallery, path: "#gallery" },
];

const contactUrl = isEnglish
  ? "https://wa.me/50686654446?text=Hello"
  : "https://wa.me/50686654446?text=Hola";
---

<!-- Invisible hover strip: lets the mouse reveal the header even while it's
     slid off-screen, since the header's own hit area moves with its transform. -->
<div id="nav-hover-strip" class="fixed top-0 left-0 w-full h-3 z-40"></div>

<header id="site-header" class="fixed top-0 left-0 z-50 flex h-22 w-full justify-center bg-[#0B0F0C]/85 transition-transform duration-500 ease-in-out lg:backdrop-blur-sm">
  <div class="w-full max-w px-6 md:max-w-5xl xl:max-w-[70%] flex items-center justify-between relative">

    <a href={basePath} class="absolute">
      <img class="w-[60px] rounded-full" src="/images/still-wild-nature.jpg" alt="Logo" />
    </a>

    <button
      id="menu-btn"
      class="ml-auto flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-full border border-white/15 bg-white/5 transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B4D990] lg:hidden"
      aria-label={isEnglish ? "Open navigation menu" : "Abrir menú de navegación"}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open-label={isEnglish ? "Open navigation menu" : "Abrir menú de navegación"}
      data-close-label={isEnglish ? "Close navigation menu" : "Cerrar menú de navegación"}
    >
      <span class="line line-1 block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="line line-2 block h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="line line-3 block h-0.5 w-6 bg-white transition-all duration-300"></span>
    </button>

    <button
      id="menu-backdrop"
      type="button"
      class="pointer-events-none fixed inset-0 z-[55] bg-black/65 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 lg:hidden"
      aria-label={isEnglish ? "Close navigation menu" : "Cerrar menú de navegación"}
      aria-hidden="true"
      tabindex="-1"
    ></button>

    <nav
      id="mobile-menu"
      aria-label={isEnglish ? "Main navigation" : "Navegación principal"}
      aria-hidden="true"
      inert
      class="fixed inset-y-0 right-0 z-[60] flex h-[100dvh] w-[min(88vw,24rem)] translate-x-full flex-col overflow-y-auto border-l border-white/10 bg-[#101A14] px-6 pt-[calc(env(safe-area-inset-top)+1.5rem)] pb-[calc(env(safe-area-inset-bottom)+1.5rem)] text-white shadow-2xl transition-transform duration-300 ease-out lg:static lg:z-auto lg:h-16 lg:w-full lg:translate-x-0 lg:flex-row lg:items-center lg:justify-between lg:overflow-visible lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:shadow-none lg:transition-none"
    >
      <div class="mb-10 flex items-center justify-between lg:hidden">
        <a href={basePath} class="flex items-center gap-3" tabindex="-1">
          <img class="h-12 w-12 rounded-full border border-[#B4D990]/40 object-cover" src="/images/still-wild-nature.jpg" alt="" />
          <span class="text-base font-semibold tracking-tight text-[#F2E6C8]">Still Wild Nature</span>
        </a>
        <button
          id="menu-close"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 text-white/80 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B4D990]"
          aria-label={isEnglish ? "Close menu" : "Cerrar menú"}
          tabindex="-1"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
            <path d="m18 6-12 12M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <ul class="flex w-full flex-col gap-2 lg:mr-auto lg:ml-auto lg:w-6/12 lg:flex-row lg:items-center lg:justify-between lg:gap-1 xl:w-6/12">
        {navigation.map((item) => (
          <li class="w-full lg:w-auto">
            <a
              href={item.path}
              tabindex="-1"
              data-section-link
              class="flex min-h-14 w-full items-center rounded-xl border border-white/[0.07] bg-white/[0.035] px-4 text-lg font-medium text-white/85 transition hover:border-[#B4D990]/40 hover:bg-[#B4D990]/10 hover:text-[#E3F2D1] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B4D990] lg:min-h-0 lg:w-auto lg:justify-center lg:rounded-none lg:border-0 lg:border-b-2 lg:border-b-transparent lg:bg-transparent lg:px-3 lg:py-2 lg:text-sm lg:hover:border-b-white lg:hover:bg-transparent lg:hover:text-white"
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-auto flex w-full flex-col gap-3 border-t border-white/10 pt-6 lg:mt-0 lg:w-auto lg:flex-row lg:items-center lg:gap-2 lg:border-0 lg:pt-0">
        <a
          href={isEnglish ? "/es" : "/"}
          tabindex="-1"
          class="flex min-h-12 w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 text-sm font-semibold text-white/90 transition hover:border-[#B4D990]/35 hover:bg-white/10 lg:min-h-10 lg:w-auto lg:rounded-lg lg:border-transparent lg:bg-transparent lg:px-3"
          aria-label={t.nav.switchLanguage}
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="lucide lucide-globe w-5 h-5">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
            </svg>
          <span>{isEnglish ? "ES" : "EN"}</span>
        </a>

        <a
          href={contactUrl}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          class="flex min-h-12 w-full items-center justify-center rounded-xl bg-[#4E7C59] px-6 text-sm font-semibold text-white shadow-lg shadow-black/20 transition hover:bg-[#5D8D67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B4D990] lg:min-h-10 lg:w-auto lg:rounded-md"
        >
          {t.nav.contactUs}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  @media (min-width: 1024px) {
    #mobile-menu a[aria-current="location"] {
      border-bottom-color: #B4D990;
      color: #B4D990;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollSmoother } from "gsap/ScrollSmoother";

  gsap.registerPlugin(ScrollTrigger);

  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("menu-backdrop");
  const closeBtn = document.getElementById("menu-close");

  const line1 = btn?.querySelector(".line-1");
  const line2 = btn?.querySelector(".line-2");
  const line3 = btn?.querySelector(".line-3");

  const desktopNav = window.matchMedia("(min-width: 1024px)");
  let menuOpen = false;
  let previousBodyOverflow = "";

  const setMenuOpen = (open) => {
    menuOpen = open && !desktopNav.matches;
    menu?.classList.toggle("translate-x-0", menuOpen);
    menu?.classList.toggle("translate-x-full", !menuOpen);
    menu?.toggleAttribute("inert", !menuOpen && !desktopNav.matches);
    menu?.setAttribute("aria-hidden", String(!menuOpen && !desktopNav.matches));

    backdrop?.classList.toggle("pointer-events-auto", menuOpen);
    backdrop?.classList.toggle("pointer-events-none", !menuOpen);
    backdrop?.classList.toggle("opacity-100", menuOpen);
    backdrop?.classList.toggle("opacity-0", !menuOpen);
    backdrop?.setAttribute("aria-hidden", String(!menuOpen));
    if (backdrop instanceof HTMLButtonElement) backdrop.tabIndex = menuOpen ? 0 : -1;

    btn?.setAttribute("aria-expanded", String(menuOpen));
    btn?.setAttribute("aria-label", menuOpen
      ? btn.dataset.closeLabel ?? "Close navigation menu"
      : btn.dataset.openLabel ?? "Open navigation menu");
    line1?.classList.toggle("rotate-45", menuOpen);
    line1?.classList.toggle("translate-y-2", menuOpen);
    line2?.classList.toggle("opacity-0", menuOpen);
    line3?.classList.toggle("-rotate-45", menuOpen);
    line3?.classList.toggle("-translate-y-2", menuOpen);

    menu?.querySelectorAll("[tabindex]").forEach((element) => {
      element.tabIndex = menuOpen || desktopNav.matches ? 0 : -1;
    });

    if (menuOpen) {
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    } else {
      document.body.style.overflow = previousBodyOverflow;
    }
  };

  btn?.addEventListener("click", () => setMenuOpen(!menuOpen));
  closeBtn?.addEventListener("click", () => {
    setMenuOpen(false);
    btn?.focus();
  });
  backdrop?.addEventListener("click", () => {
    setMenuOpen(false);
    btn?.focus();
  });
  if (menu) {
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || !menuOpen) return;
      const focusable = Array.from(menu.querySelectorAll('a[href], button:not([disabled])'))
        .filter((element) => element.tabIndex >= 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
  }
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuOpen) {
      setMenuOpen(false);
      btn?.focus();
    }
  });
  setMenuOpen(false);

  // The page scrolls via GSAP ScrollSmoother (a transform on #content, not
  // real window scroll). A native "#anchor" jump moves the browser's real
  // scroll position without telling ScrollSmoother, so the two desync and
  // everything above the target renders in the wrong place. Route in-page
  // anchor clicks through ScrollSmoother's own scrollTo instead.
  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      const id = link.getAttribute("href");
      const target = id && document.querySelector(id);
      if (!target) return;

      e.preventDefault();
      setMenuOpen(false);
      if (!desktopNav.matches) btn?.focus();

      const smoother = ScrollSmoother.get();
      if (smoother) {
        smoother.scrollTo(target, true, "top center");
      } else {
        target.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      history.pushState(null, "", id);
    });
  });

  const sectionLinks = Array.from(document.querySelectorAll("#mobile-menu a[data-section-link]"));
  const setActiveSectionLink = (activeLink) => {
    sectionLinks.forEach((link) => {
      if (link === activeLink) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };

  sectionLinks.forEach((link, index) => {
    const href = link.getAttribute("href");
    const section = href ? document.querySelector(href) : null;
    if (!section) return;

    ScrollTrigger.create({
      trigger: section,
      start: "top 38%",
      end: "bottom 38%",
      onEnter: () => setActiveSectionLink(link),
      onEnterBack: () => setActiveSectionLink(link),
      onLeaveBack: () => {
        if (index === 0) setActiveSectionLink(null);
      },
    });
  });

  // Auto-hide header: slides up out of view when scrolling down, slides back
  // down when scrolling up, when the mouse hovers near the top of the page,
  // or while the hero banner is still on screen.
  const header = document.getElementById("site-header");
  const hoverStrip = document.getElementById("nav-hover-strip");
  const banner = document.querySelector(".banner-video");

  let lastScrollY = window.scrollY;
  let headerHidden = false;

  const setHeaderHidden = (hidden) => {
    if (hidden === headerHidden || !header) return;
    headerHidden = hidden;
    header.style.transform = hidden ? "translateY(-100%)" : "translateY(0)";
  };

  desktopNav.addEventListener("change", () => {
    setMenuOpen(false);
    if (!desktopNav.matches && header) {
      headerHidden = false;
      header.style.removeProperty("transform");
    }
  });

  const inBanner = () => {
    if (!banner) return window.scrollY < window.innerHeight;
    return banner.getBoundingClientRect().bottom > 0;
  };

  window.addEventListener("scroll", () => {
    const y = window.scrollY;
    const delta = y - lastScrollY;
    if (!desktopNav.matches || menuOpen || inBanner()) {
      setHeaderHidden(false);
    } else if (delta > 2) {
      setHeaderHidden(true);
    } else if (delta < -2) {
      setHeaderHidden(false);
    }

    lastScrollY = y;
  }, { passive: true });

  header?.addEventListener("mouseenter", () => setHeaderHidden(false));
  hoverStrip?.addEventListener("mouseenter", () => setHeaderHidden(false));
</script>
