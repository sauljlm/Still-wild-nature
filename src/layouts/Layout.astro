---
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import MistBackground from "@/components/MistBackground.astro";
import KeepScrolling from "@/assets/keep-scrolling.svg"

const { lang = "en" } = Astro.props;
const isSpanish = lang === "es";
const seo = isSpanish
  ? {
      title: "Caminatas guiadas en Monteverde | Still Wild Nature",
      description:
        "Explora el bosque nuboso de Monteverde con caminatas nocturnas de vida silvestre, observación de aves e historia natural junto a un guía naturalista local.",
      locale: "es_CR",
      imageAlt: "Vida silvestre en el bosque nuboso de Monteverde",
    }
  : {
      title: "Monteverde Night Wildlife Walks | Still Wild Nature",
      description:
        "Explore Monteverde's cloud forest on guided night wildlife walks, birdwatching tours, and natural history walks with a local naturalist. Private tours available.",
      locale: "en_US",
      imageAlt: "Wildlife in the Monteverde cloud forest",
    };
const socialImage = "/images/gallery/img1.webp";
const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const pageUrl = siteUrl ? `${siteUrl}${isSpanish ? "/es" : "/"}` : undefined;

const structuredData = siteUrl
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          name: "Still Wild Nature",
          url: siteUrl,
          logo: `${siteUrl}/images/still-wild-nature.jpg`,
          image: `${siteUrl}${socialImage}`,
          email: "stillwildnature@gmail.com",
          telephone: "+50686654446",
          areaServed: {
            "@type": "Place",
            name: "Monteverde, Costa Rica",
          },
          knowsAbout: [
            "Monteverde cloud forest",
            "Night wildlife walks",
            "Birdwatching",
            "Natural history walks",
          ],
          sameAs: [
            "https://www.instagram.com/still_wild_nature/",
            "https://www.google.com/maps/place/Still+Wild+Nature%2FNight+walk+Tour/@10.2662426,-84.9817386,13z/data=!3m1!4b1!4m3!3m2!1s0x2588265d27bf78b9:0xfaaed99520822d07!16s%2Fg%2F11ymyz0yw4",
          ],
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          name: "Still Wild Nature",
          url: siteUrl,
          inLanguage: ["en", "es"],
          publisher: { "@id": `${siteUrl}/#organization` },
        },
      ],
    }
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" as="image" href="/images/gallery/img6.webp" fetchpriority="high" />
    <link rel="icon" type="image/jpeg" href="/images/still-wild-nature.jpg" />
    <link rel="apple-touch-icon" href="/images/still-wild-nature.jpg" />
    <meta name="theme-color" content="#0B0F0C" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Still Wild Nature" />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:locale:alternate" content={isSpanish ? "en_US" : "es_CR"} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {siteUrl && <meta property="og:image" content={`${siteUrl}${socialImage}`} />}
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {siteUrl && <meta name="twitter:image" content={`${siteUrl}${socialImage}`} />}
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    {siteUrl && (
      <>
        <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
        <link rel="alternate" hreflang="es" href={`${siteUrl}/es`} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
      </>
    )}
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    )}
  </head>
  <body>
    <div id="wrapper">
      <MistBackground />
      <Nav lang={lang} />
      <div id="content">
        <slot />
        <Footer lang={lang} />
      </div>
      <KeepScrolling
        class="fixed bottom-5 md:bottom-3 right-0 left-0 mx-auto text-white drop-shadow-2xl animate-bounce-pulse z-10"
      />
    </div>

    <script>
      import { gsap } from "gsap"
      import { ScrollTrigger } from "gsap/ScrollTrigger"
      import { ScrollSmoother } from "gsap/ScrollSmoother"

      gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

      ScrollSmoother.create({
        wrapper: "#wrapper",
        content: "#content",
        smooth: 2,
        speed: 1.2,
        effects: true
      });
    </script>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  @theme {
    --animate-bounce-pulse: bounce-pulse 2s ease-in-out infinite;
  }

  @keyframes bounce-pulse {
    0% {
      transform: translateY(0);
      scale: 0.8;
      opacity: 0.8;
    }

    50% {
      transform: translateY(-5px);
      opacity: 1;
      scale: 1;
    }

    100% {
      transform: translateY(0);
      scale: 0.8;
      opacity: 0.8;
    }
  }

  html,
  body {
    background: #0B0F0C;
    min-height: 300vh;
    overflow-x: hidden;
    overscroll-behavior-y: auto;
    color: white;
    margin: 0;
    width: 100%;
  }
</style>
